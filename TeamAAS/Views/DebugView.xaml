<UserControl x:Class="TeamAAS.Views.DebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Device Tree -->
        <Border Grid.Column="0" Background="{DynamicResource RegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="8,12">
                <TextBlock DockPanel.Dock="Top" Text="设备列表" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                <TreeView Background="Transparent" BorderThickness="0">
                    <TreeViewItem Header="视觉方案" IsExpanded="True">
                        <TreeViewItem Header="方案1"/>
                        <TreeViewItem Header="方案2"/>
                    </TreeViewItem>
                    <TreeViewItem Header="机器人" IsExpanded="True">
                        <TreeViewItem Header="机器人1 (EPSON)"/>
                    </TreeViewItem>
                    <TreeViewItem Header="供料器"/>
                    <TreeViewItem Header="光源"/>
                    <TreeViewItem Header="IO调试"/>
                    <TreeViewItem Header="脚本"/>
                </TreeView>
            </DockPanel>
        </Border>

        <!-- Center: Debug Content -->
        <Border Grid.Column="1" Background="{DynamicResource BackgroundBrush}">
            <Grid>
                <TextBlock Text="调试内容区" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="20" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </Grid>
        </Border>

        <!-- Right: Properties -->
        <Border Grid.Column="2" Background="{DynamicResource RegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
            <DockPanel Margin="12,12">
                <TextBlock DockPanel.Dock="Top" Text="节点属性" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                <StackPanel>
                    <TextBlock Text="节点名称" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="拍照" Margin="0,0,0,12"/>
                    <TextBlock Text="相机选择" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox SelectedIndex="0" Margin="0,0,0,12">
                        <ComboBoxItem Content="相机1"/>
                        <ComboBoxItem Content="相机2"/>
                    </ComboBox>
                    <TextBlock Text="曝光时间" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="5000" Margin="0,0,0,12"/>
                    <Button Content="保存" Style="{StaticResource ButtonPrimary}" Padding="16,4"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
