<UserControl x:Class="TeamAAS.Views.SettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:conv="clr-namespace:TeamAAS.Converters"
             xmlns:ctrl="clr-namespace:TeamAAS.Control.Controls;assembly=TeamAAS.Control"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <conv:IsEqualConverter x:Key="IsEqualConverter"/>

        <!-- 子导航按钮样式 -->
        <Style x:Key="SubNavItem" TargetType="RadioButton">
            <Setter Property="GroupName" Value="SettingNav"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="cp" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Jog按钮样式 -->
        <Style x:Key="JogButton" TargetType="Button">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="0,14"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{DynamicResource SecondaryRegionBrush}" 
                                CornerRadius="4" BorderThickness="1" 
                                BorderBrush="{DynamicResource BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource RegionBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：子导航 -->
        <Border Grid.Column="0" Background="{DynamicResource RegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="8,12">
                <TextBlock Text="设备管理" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="8,0,0,12"/>
                <RadioButton Style="{StaticResource SubNavItem}" Content="📷 相机管理"
                             IsChecked="{Binding SelectedSection, Converter={StaticResource IsEqualConverter}, ConverterParameter=Camera, Mode=TwoWay}"/>
                <RadioButton Style="{StaticResource SubNavItem}" Content="🤖 机器人"
                             IsChecked="{Binding SelectedSection, Converter={StaticResource IsEqualConverter}, ConverterParameter=Robot, Mode=TwoWay}"/>
                <RadioButton Style="{StaticResource SubNavItem}" Content="📡 PLC"
                             IsChecked="{Binding SelectedSection, Converter={StaticResource IsEqualConverter}, ConverterParameter=PLC, Mode=TwoWay}"/>
                <RadioButton Style="{StaticResource SubNavItem}" Content="💡 光源"
                             IsChecked="{Binding SelectedSection, Converter={StaticResource IsEqualConverter}, ConverterParameter=Light, Mode=TwoWay}"/>
                <RadioButton Style="{StaticResource SubNavItem}" Content="📦 供料器"
                             IsChecked="{Binding SelectedSection, Converter={StaticResource IsEqualConverter}, ConverterParameter=Feeder, Mode=TwoWay}"/>
                <RadioButton Style="{StaticResource SubNavItem}" Content="🔌 通信"
                             IsChecked="{Binding SelectedSection, Converter={StaticResource IsEqualConverter}, ConverterParameter=Comm, Mode=TwoWay}"/>
            </StackPanel>
        </Border>

        <!-- 右侧：内容区 -->
        <Grid Grid.Column="1" Margin="16,12">

            <!-- ========== 相机管理 ========== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="Camera">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 工具栏 -->
                <Border Grid.Row="0" Background="{DynamicResource SecondaryRegionBrush}"
                        CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="搜索并添加相机" Command="{Binding SearchDevicesCommand}"
                                Style="{StaticResource ButtonPrimary}" Margin="0,0,8,0" Padding="16,6"/>
                        <Rectangle Width="1" Height="24" Fill="{DynamicResource BorderBrush}" Margin="4,0"/>
                        <Button Content="连接" Command="{Binding ConnectCommand}"
                                Style="{StaticResource ButtonDefault}" Margin="8,0,4,0" Padding="16,6"
                                IsEnabled="{Binding HasSelectedCamera}"/>
                        <Button Content="断开" Command="{Binding DisconnectCommand}"
                                Style="{StaticResource ButtonDefault}" Margin="4,0,8,0" Padding="16,6"
                                IsEnabled="{Binding HasSelectedCamera}"/>
                        <Rectangle Width="1" Height="24" Fill="{DynamicResource BorderBrush}" Margin="4,0"/>
                        <Button Content="开始采集" Command="{Binding StartGrabbingCommand}"
                                Style="{StaticResource ButtonDefault}" Margin="8,0,4,0" Padding="16,6"
                                IsEnabled="{Binding HasSelectedCamera}"/>
                        <Button Content="停止采集" Command="{Binding StopGrabbingCommand}"
                                Style="{StaticResource ButtonDefault}" Margin="4,0,8,0" Padding="16,6"
                                IsEnabled="{Binding HasSelectedCamera}"/>
                        <Rectangle Width="1" Height="24" Fill="{DynamicResource BorderBrush}" Margin="4,0"/>
                        <Button Content="删除相机" Command="{Binding DeleteCameraCommand}"
                                Style="{StaticResource ButtonDanger}" Margin="8,0,0,0" Padding="16,6"
                                IsEnabled="{Binding HasSelectedCamera}"/>
                    </StackPanel>
                </Border>

                <!-- SDK状态条 -->
                <Border Grid.Row="1" Background="{DynamicResource SecondaryRegionBrush}"
                        CornerRadius="6" Padding="12,6" Margin="0,0,0,12">
                    <ItemsControl ItemsSource="{Binding SdkStatus}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#F44336"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Installed}" Value="True">
                                                        <Setter Property="Fill" Value="#4CAF50"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="未安装"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Installed}" Value="True">
                                                        <Setter Property="Text" Value="{Binding Version, StringFormat='v{0}'}"/>
                                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- 主内容：相机列表 + 图像预览 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：已配置相机列表 -->
                    <Border Grid.Column="0" Background="{DynamicResource RegionBrush}"
                            CornerRadius="8" Margin="0,0,6,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="已配置相机" FontSize="14" FontWeight="Bold"
                                       Margin="16,12,0,8" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <DataGrid ItemsSource="{Binding Cameras}"
                                      SelectedItem="{Binding SelectedCamera}"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsReadOnly="True" HeadersVisibility="All"
                                      GridLinesVisibility="Horizontal" BorderThickness="0"
                                      AlternatingRowBackground="{DynamicResource SecondaryRegionBrush}"
                                      Margin="8,0,8,8">
                               
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="编号" Binding="{Binding CameraNo}" Width="50"/>
                                    <DataGridTextColumn Header="名称" Binding="{Binding CameraName}" Width="150"/>
                                    <DataGridTextColumn Header="品牌" Binding="{Binding CameraBrandDisplay}" Width="100"/>
                                    <DataGridTextColumn Header="IP地址" Binding="{Binding CameraIp}" Width="110"/>
                                    <DataGridTextColumn Header="序列号" Binding="{Binding SerialNumber}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- 右侧：实时图像预览 -->
                    <Border Grid.Column="1" Background="{DynamicResource RegionBrush}"
                            CornerRadius="8" Margin="6,0,0,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="16,12,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="实时图像" FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding FpsText}" FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                            </Grid>
                            <Border Background="Black" CornerRadius="4" Margin="8,0,8,8">
                                <ctrl:ImageDisplayControl Source="{Binding CurrentImage}"/>
                            </Border>
                        </DockPanel>
                    </Border>

                </Grid>
            </Grid>

            <!-- ========== 机器人管理 ========== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="Robot">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 工具栏 -->
                <Border Grid.Row="0" Background="{DynamicResource SecondaryRegionBrush}"
                        CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="添加机器人" Command="{Binding AddRobotCommand}"
                                Style="{StaticResource ButtonPrimary}" Margin="0,0,8,0" Padding="16,6"/>
                        <Rectangle Width="1" Height="24" Fill="{DynamicResource BorderBrush}" Margin="4,0"/>
                        <Button Content="连接" Command="{Binding ConnectRobotCommand}"
                                Style="{StaticResource ButtonDefault}" Margin="8,0,4,0" Padding="16,6"
                                IsEnabled="{Binding HasSelectedRobot}"/>
                        <Button Content="断开" Command="{Binding DisconnectRobotCommand}"
                                Style="{StaticResource ButtonDefault}" Margin="4,0,8,0" Padding="16,6"
                                IsEnabled="{Binding HasSelectedRobot}"/>
                        <Rectangle Width="1" Height="24" Fill="{DynamicResource BorderBrush}" Margin="4,0"/>
                        <Button Content="电机开" Command="{Binding MotorOnCommand}"
                                Style="{StaticResource ButtonDefault}" Margin="8,0,4,0" Padding="16,6"
                                IsEnabled="{Binding HasSelectedRobot}"/>
                        <Button Content="电机关" Command="{Binding MotorOffCommand}"
                                Style="{StaticResource ButtonDefault}" Margin="4,0,8,0" Padding="16,6"
                                IsEnabled="{Binding HasSelectedRobot}"/>
                        <Button Content="重置" Command="{Binding ResetRobotCommand}"
                                Style="{StaticResource ButtonDefault}" Margin="4,0,8,0" Padding="16,6"
                                IsEnabled="{Binding HasSelectedRobot}"/>
                        <Rectangle Width="1" Height="24" Fill="{DynamicResource BorderBrush}" Margin="4,0"/>
                        <Button Content="释放刹车" Command="{Binding SFreeRobotCommand}"
                                Style="{StaticResource ButtonDefault}" Margin="8,0,4,0" Padding="16,6"
                                IsEnabled="{Binding HasSelectedRobot}"/>
                        <Button Content="锁定刹车" Command="{Binding SLockRobotCommand}"
                                Style="{StaticResource ButtonDefault}" Margin="4,0,8,0" Padding="16,6"
                                IsEnabled="{Binding HasSelectedRobot}"/>
                        <Rectangle Width="1" Height="24" Fill="{DynamicResource BorderBrush}" Margin="4,0"/>
                        <Button Content="删除" Command="{Binding DeleteRobotCommand}"
                                Style="{StaticResource ButtonDanger}" Margin="8,0,0,0" Padding="16,6"
                                IsEnabled="{Binding HasSelectedRobot}"/>
                    </StackPanel>
                </Border>

                <!-- 主内容：机器人列表 + 手动调试 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：机器人列表 -->
                    <Border Grid.Column="0" Background="{DynamicResource RegionBrush}"
                            CornerRadius="8" Margin="0,0,6,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="机器人列表" FontSize="14" FontWeight="Bold"
                                       Margin="16,12,0,8" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <DataGrid ItemsSource="{Binding Robots}"
                                      SelectedItem="{Binding SelectedRobot}"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsReadOnly="True" HeadersVisibility="All"
                                      GridLinesVisibility="Horizontal" BorderThickness="0"
                                      AlternatingRowBackground="{DynamicResource SecondaryRegionBrush}"
                                      Margin="8,0,8,8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="编号" Binding="{Binding RobotNo}" Width="50"/>
                                    <DataGridTextColumn Header="名称" Binding="{Binding RobotName}" Width="120"/>
                                    <DataGridTextColumn Header="品牌" Binding="{Binding RobotBrand}" Width="80"/>
                                    <DataGridTextColumn Header="IP地址" Binding="{Binding IP}" Width="110"/>
                                    <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="60"/>
                                    <DataGridTextColumn Header="连接方式" Binding="{Binding ConnectType}" Width="80"/>
                                    <DataGridTextColumn Header="结束符" Binding="{Binding Terminator}" Width="70"/>
                                    <DataGridTextColumn Header="编码格式" Binding="{Binding DataEncoding}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- 右侧：手动调试面板 -->
                    <Border Grid.Column="1" Background="{DynamicResource RegionBrush}"
                            CornerRadius="8" Margin="6,0,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="手动调试" FontSize="14" FontWeight="Bold"
                                       Margin="16,12,0,8" Foreground="{DynamicResource PrimaryTextBrush}"/>

                            <!-- 状态栏 -->
                            <Border DockPanel.Dock="Top" Background="{DynamicResource SecondaryRegionBrush}"
                                    CornerRadius="4" Padding="12,6" Margin="12,0,12,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="状态: " FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding RobotConnectionStatus}" FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Text="  |  " FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding RobotMessage}" FontSize="12" 
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- 坐标显示 -->
                            <Border DockPanel.Dock="Top" Background="#1E1E1E" CornerRadius="4" 
                                    Padding="16,10" Margin="12,0,12,8">
                                <StackPanel>
                                    <TextBlock Text="当前坐标" FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding RobotPosText}" FontSize="13" FontFamily="Consolas"
                                               Foreground="#4FC3F7" LineHeight="20"/>
                                </StackPanel>
                            </Border>

                            <!-- 步进距离 + Tool选择 -->
                            <Grid DockPanel.Dock="Top" Margin="12,0,12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="步进:" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <hc:NumericUpDown Value="{Binding JogStepDistance}" 
                                                      Minimum="0.1" Maximum="100" Increment="0.1"
                                                      Width="80" FontSize="12" DecimalPlaces="3"/>
                                    <TextBlock Text="mm" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Tool:" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox SelectedIndex="{Binding SelectedToolIndex}" Width="60" FontSize="12">
                                        <ComboBoxItem Content="0"/>
                                        <ComboBoxItem Content="1"/>
                                        <ComboBoxItem Content="2"/>
                                        <ComboBoxItem Content="3"/>
                                        <ComboBoxItem Content="4"/>
                                        <ComboBoxItem Content="5"/>
                                        <ComboBoxItem Content="6"/>
                                        <ComboBoxItem Content="7"/>
                                        <ComboBoxItem Content="8"/>
                                        <ComboBoxItem Content="9"/>
                                        <ComboBoxItem Content="10"/>
                                        <ComboBoxItem Content="11"/>
                                        <ComboBoxItem Content="12"/>
                                        <ComboBoxItem Content="13"/>
                                        <ComboBoxItem Content="14"/>
                                        <ComboBoxItem Content="15"/>
                                    </ComboBox>
                                    <Button Content="选择" Command="{Binding SelectToolCommand}" 
                                            FontSize="11" Padding="8,2" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Jog方向按钮区 -->
                            <Border DockPanel.Dock="Top" Background="{DynamicResource SecondaryRegionBrush}"
                                    CornerRadius="4" Padding="16" Margin="12,0,12,12">
                                <StackPanel>
                                    <!-- 空间轴 -->
                                    <TextBlock Text="空间轴 (X / Y / Z)" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,0,0,8" HorizontalAlignment="Center"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Row="0" Grid.Column="0" Content="X+" Style="{StaticResource JogButton}"
                                                Command="{Binding JogCommand}" CommandParameter="X+"
                                                IsEnabled="{Binding HasSelectedRobot}"/>
                                        <Button Grid.Row="0" Grid.Column="1" Content="Y+" Style="{StaticResource JogButton}"
                                                Command="{Binding JogCommand}" CommandParameter="Y+"
                                                IsEnabled="{Binding HasSelectedRobot}"/>
                                        <Button Grid.Row="0" Grid.Column="2" Content="Z+" Style="{StaticResource JogButton}"
                                                Command="{Binding JogCommand}" CommandParameter="Z+"
                                                IsEnabled="{Binding HasSelectedRobot}"/>
                                        <Button Grid.Row="1" Grid.Column="0" Content="X-" Style="{StaticResource JogButton}"
                                                Command="{Binding JogCommand}" CommandParameter="X-"
                                                IsEnabled="{Binding HasSelectedRobot}"/>
                                        <Button Grid.Row="1" Grid.Column="1" Content="Y-" Style="{StaticResource JogButton}"
                                                Command="{Binding JogCommand}" CommandParameter="Y-"
                                                IsEnabled="{Binding HasSelectedRobot}"/>
                                        <Button Grid.Row="1" Grid.Column="2" Content="Z-" Style="{StaticResource JogButton}"
                                                Command="{Binding JogCommand}" CommandParameter="Z-"
                                                IsEnabled="{Binding HasSelectedRobot}"/>
                                    </Grid>

                                    <!-- 分隔线 -->
                                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,12"/>

                                    <!-- 旋转轴 -->
                                    <TextBlock Text="旋转轴 (U / V / W)" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,0,0,8" HorizontalAlignment="Center"/>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Row="0" Grid.Column="0" Content="U+" Style="{StaticResource JogButton}"
                                                Command="{Binding JogCommand}" CommandParameter="U+"
                                                IsEnabled="{Binding HasSelectedRobot}"/>
                                        <Button Grid.Row="0" Grid.Column="1" Content="V+" Style="{StaticResource JogButton}"
                                                Command="{Binding JogCommand}" CommandParameter="V+"
                                                IsEnabled="{Binding HasSelectedRobot}"/>
                                        <Button Grid.Row="0" Grid.Column="2" Content="W+" Style="{StaticResource JogButton}"
                                                Command="{Binding JogCommand}" CommandParameter="W+"
                                                IsEnabled="{Binding HasSelectedRobot}"/>
                                        <Button Grid.Row="1" Grid.Column="0" Content="U-" Style="{StaticResource JogButton}"
                                                Command="{Binding JogCommand}" CommandParameter="U-"
                                                IsEnabled="{Binding HasSelectedRobot}"/>
                                        <Button Grid.Row="1" Grid.Column="1" Content="V-" Style="{StaticResource JogButton}"
                                                Command="{Binding JogCommand}" CommandParameter="V-"
                                                IsEnabled="{Binding HasSelectedRobot}"/>
                                        <Button Grid.Row="1" Grid.Column="2" Content="W-" Style="{StaticResource JogButton}"
                                                Command="{Binding JogCommand}" CommandParameter="W-"
                                                IsEnabled="{Binding HasSelectedRobot}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ========== PLC（占位） ========== -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="PLC">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="📡 PLC配置" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="开发中..." FontSize="14" Margin="0,8,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- ========== 光源（占位） ========== -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="Light">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="💡 光源配置" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="开发中..." FontSize="14" Margin="0,8,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- ========== 供料器（占位） ========== -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="Feeder">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="📦 供料器配置" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="开发中..." FontSize="14" Margin="0,8,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- ========== 通信（占位） ========== -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="Comm">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="🔌 通信配置" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="开发中..." FontSize="14" Margin="0,8,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
            </StackPanel>

        </Grid>
    </Grid>
</UserControl>
