<Window x:Class="TeamAAS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:conv="clr-namespace:TeamAAS.Converters"
        Title="TeamAAS 3.0"
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource RegionBrush}">

    <Window.Resources>
        <conv:IsEqualConverter x:Key="IsEqualConverter"/>

        <!-- Icon Geometries (Material Design paths) -->
        <Geometry x:Key="HomeIcon">M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z</Geometry>
        <Geometry x:Key="ProductIcon">M12,2L2,7V17L12,22L22,17V7L12,2Z M12,2V12 M2,7L12,12L22,7</Geometry>
        <Geometry x:Key="DebugIcon">M22.7,19L13.6,9.9C14.5,7.6 14,4.9 12.1,3C10.1,1 7.1,0.6 4.5,1.7L9,6.2L6.2,9L1.7,4.5C0.6,7.1 1,10.1 3,12.1C4.9,14 7.6,14.5 9.9,13.6L19,22.7C19.4,23.1 20,23.1 20.4,22.7L22.7,20.4C23.1,20 23.1,19.4 22.7,19Z</Geometry>
        <Geometry x:Key="SettingIcon">M19.14,12.94C19.18,12.64 19.2,12.33 19.2,12C19.2,11.68 19.18,11.36 19.13,11.06L21.16,9.48C21.34,9.34 21.39,9.07 21.27,8.87L19.35,5.55C19.23,5.33 18.96,5.25 18.73,5.33L16.38,6.28C15.88,5.89 15.35,5.56 14.76,5.32L14.4,2.81C14.36,2.57 14.16,2.4 13.92,2.4H10.08C9.83,2.4 9.63,2.57 9.59,2.81L9.24,5.32C8.65,5.56 8.11,5.89 7.62,6.28L5.27,5.33C5.04,5.25 4.77,5.33 4.65,5.55L2.73,8.87C2.61,9.07 2.66,9.34 2.84,9.48L4.87,11.06C4.82,11.36 4.8,11.68 4.8,12C4.8,12.33 4.82,12.64 4.87,12.94L2.84,14.52C2.66,14.66 2.61,14.93 2.73,15.13L4.65,18.45C4.77,18.67 5.04,18.75 5.27,18.67L7.62,17.72C8.11,18.11 8.65,18.44 9.24,18.68L9.6,21.19C9.64,21.43 9.84,21.6 10.08,21.6H13.92C14.17,21.6 14.37,21.43 14.41,21.19L14.76,18.68C15.35,18.44 15.89,18.11 16.38,17.72L18.73,18.67C18.96,18.75 19.23,18.67 19.35,18.45L21.27,15.13C21.39,14.93 21.34,14.66 21.16,14.52L19.14,12.94ZM12,15.6C10.02,15.6 8.4,13.98 8.4,12C8.4,10.02 10.02,8.4 12,8.4C13.98,8.4 15.6,10.02 15.6,12C15.6,13.98 13.98,15.6 12,15.6Z</Geometry>
        <Geometry x:Key="CalibrationIcon">M14.06,9L15,9.94L5.92,19H5V18.08L14.06,9M17.66,3C17.41,3 17.15,3.1 16.96,3.29L15.13,5.12L18.88,8.87L20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18.17,3.09 17.92,3 17.66,3M14.06,6.19L3,17.25V21H6.75L17.81,9.94L14.06,6.19Z</Geometry>
        <Geometry x:Key="StatisticsIcon">M3,3H21V21H3V3Z M7,17V11 M12,17V7 M17,17V13</Geometry>
        <Geometry x:Key="ParamsIcon">M3,5H21V7H3V5Z M3,11H21V13H3V11Z M3,17H21V19H3V17Z</Geometry>
        <Geometry x:Key="UserIcon">M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z</Geometry>

        <!-- Navigation Button Style -->
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="0,6">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path x:Name="icon" Width="22" Height="22" Stretch="Uniform"
                                      Data="{TemplateBinding Tag}"
                                      Fill="{DynamicResource SecondaryTextBrush}"
                                      HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="icon" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Top Navigation Bar -->
        <Border DockPanel.Dock="Top" Height="72"
                Background="{DynamicResource RegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <!-- Left Navigation -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <RadioButton Style="{StaticResource NavButton}" Content="首页" Tag="{StaticResource HomeIcon}"
                                 GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="HomeView"
                                 IsChecked="{Binding CurrentView, Converter={StaticResource IsEqualConverter}, ConverterParameter=HomeView, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="产品" Tag="{StaticResource ProductIcon}"
                                 GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="ProductView"
                                 IsChecked="{Binding CurrentView, Converter={StaticResource IsEqualConverter}, ConverterParameter=ProductView, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="调试" Tag="{StaticResource DebugIcon}"
                                 GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="DebugView"
                                 IsChecked="{Binding CurrentView, Converter={StaticResource IsEqualConverter}, ConverterParameter=DebugView, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="设置" Tag="{StaticResource SettingIcon}"
                                 GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="SettingView"
                                 IsChecked="{Binding CurrentView, Converter={StaticResource IsEqualConverter}, ConverterParameter=SettingView, Mode=TwoWay}"/>
                </StackPanel>

                <!-- Center Title -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="TeamAAS 3.0" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryBrush}"/>
                </StackPanel>

                <!-- Right Navigation + Theme Toggle -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Rectangle Width="1" Height="36" Fill="{DynamicResource BorderBrush}" Margin="6,0"/>

                    <RadioButton Style="{StaticResource NavButton}" Content="标定" Tag="{StaticResource CalibrationIcon}"
                                 GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="CalibrationView"
                                 IsChecked="{Binding CurrentView, Converter={StaticResource IsEqualConverter}, ConverterParameter=CalibrationView, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="统计" Tag="{StaticResource StatisticsIcon}"
                                 GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="StatisticsView"
                                 IsChecked="{Binding CurrentView, Converter={StaticResource IsEqualConverter}, ConverterParameter=StatisticsView, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="参数" Tag="{StaticResource ParamsIcon}"
                                 GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="ParamsView"
                                 IsChecked="{Binding CurrentView, Converter={StaticResource IsEqualConverter}, ConverterParameter=ParamsView, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="用户" Tag="{StaticResource UserIcon}"
                                 GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="UserView"
                                 IsChecked="{Binding CurrentView, Converter={StaticResource IsEqualConverter}, ConverterParameter=UserView, Mode=TwoWay}"/>

                    <Rectangle Width="1" Height="36" Fill="{DynamicResource BorderBrush}" Margin="6,0"/>

                    <!-- Theme Toggle Button -->
                    <Button Command="{Binding ToggleThemeCommand}"
                            Width="40" Height="40" Margin="4,0"
                            Cursor="Hand"
                            ToolTip="切换主题"
                            Background="Transparent" BorderThickness="0">
                        <TextBlock Text="{Binding ThemeIcon}" FontSize="20"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom Status Bar -->
        <Border DockPanel.Dock="Bottom" Height="28"
                Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <Ellipse Width="8" Height="8" Fill="#4CAF50" Margin="0,0,6,0"/>
                <TextBlock Text="PLC: 已连接" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,20,0"/>
                <Ellipse Width="8" Height="8" Fill="#4CAF50" Margin="0,0,6,0"/>
                <TextBlock Text="机器人1: 在线" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,20,0"/>
                <Ellipse Width="8" Height="8" Fill="#4CAF50" Margin="0,0,6,0"/>
                <TextBlock Text="相机1: 运行中" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,20,0"/>
                <Ellipse Width="8" Height="8" Fill="{DynamicResource PrimaryBrush}" Margin="0,0,6,0"/>
                <TextBlock Text="系统: 自动运行" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <ContentControl prism:RegionManager.RegionName="ContentRegion"
                        Background="{DynamicResource BackgroundBrush}"/>
    </DockPanel>
</Window>
