<hc:Window x:Class="TeamAAS.FlowEditor.Views.NodePropertyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="节点属性" Height="400" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource RegionBrush}">

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="节点名称" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtNodeName" FontSize="14" hc:InfoElement.Placeholder="输入节点名称"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="节点类型" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtNodeType" IsReadOnly="True" FontSize="14" Background="{DynamicResource SecondaryRegionBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="插件标识" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtPluginId" IsReadOnly="True" FontSize="14" Background="{DynamicResource SecondaryRegionBrush}"/>
        </StackPanel>

        <Border Grid.Row="3" Background="{DynamicResource SecondaryRegionBrush}" CornerRadius="6" Padding="12">
            <StackPanel x:Name="PropertyPanel">
                <TextBlock Text="配置属性" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>

                <StackPanel x:Name="SleepProperties" Visibility="Collapsed">
                    <TextBlock Text="休眠时间 (ms)" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                    <hc:NumericUpDown x:Name="NumDuration" Minimum="0" Maximum="60000" Increment="100" DecimalPlaces="0" Width="200" HorizontalAlignment="Left"/>
                </StackPanel>

                <StackPanel x:Name="LoopProperties" Visibility="Collapsed">
                    <TextBlock Text="循环次数" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                    <hc:NumericUpDown x:Name="NumLoopCount" Minimum="1" Maximum="100000" Increment="1" DecimalPlaces="0" Width="200" HorizontalAlignment="Left"/>
                </StackPanel>

                <StackPanel x:Name="GenericProperties" Visibility="Collapsed">
                    <TextBlock Text="该节点类型的属性编辑器正在开发中..." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Padding="20,6" Margin="0,0,8,0" Click="BtnCancel_Click"/>
            <Button Content="确定" Style="{StaticResource ButtonPrimary}" Padding="20,6" Click="BtnOK_Click"/>
        </StackPanel>
    </Grid>
</hc:Window>
